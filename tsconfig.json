{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/*.ts",
    "bin/*.ts",
    "verification/*.ts",
    "tests/*.ts",
    "examples/*.ts",
    "vite.config.ts"
  ]
}

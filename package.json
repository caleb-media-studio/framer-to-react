{
  "name": "framer-to-react",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.ts verification/*.test.ts",
    "cli": "node scripts/cli.ts",
    "compile": "node scripts/cli.ts compile",
    "typecheck": "tsc --noEmit",
    "verify:visual": "node verification/fidelity-gate.ts",
    "test:bun": "bun test tests/*.test.ts verification/*.test.ts",
    "capture:reference": "node verification/evidence-sidecar.ts",
    "capture:vectors": "node verification/vector-evidence.ts"
  },
  "dependencies": {
    "@framer/plugin": "latest",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/flowbite": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/mage": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/meteor-icons": "^1.2.10",
    "@iconify-json/nonicons": "^1.2.2",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "1.65.1",
    "@sargamicons/static": "^1.6.7",
    "@types/node": "24.19.2",
    "bun": "1.4.5",
    "lucide-static": "^1.75.0",
    "typescript": "5.9.3",
    "vite": "^6.3.0",
    "vite-plugin-framer": "^1.1.1"
  },
  "description": "Capture portable Framer design archives and compile reusable React applications",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caleb-media-studio/framer-to-react.git"
  },
  "homepage": "https://github.com/caleb-media-studio/framer-to-react",
  "bugs": {
    "url": "https://github.com/caleb-media-studio/framer-to-react/issues"
  },
  "packageManager": "bun@1.4.5",
  "bin": {
    "framer-to-react": "bin/framer-to-react.ts"
  }
}

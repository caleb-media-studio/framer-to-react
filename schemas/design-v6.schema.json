{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caleb-media-studio/framer-to-react/blob/main/schemas/design-v6.schema.json",
  "title": "Framer design snapshot v6",
  "type": "object",
  "required": [
    "roots"
  ],
  "properties": {
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "nodeCount": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "attributes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "richTextHTML": {
          "type": [
            "string",
            "null"
          ]
        },
        "rect": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "reference": false
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

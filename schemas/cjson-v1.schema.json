{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CJSON/1 data",
  "type": "object",
  "required": [
    "format",
    "referenceSha256",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "framer-to-react/cjson-v1"
    },
    "referenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/value"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -3
            }
          ],
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
